{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_parse_output.schema.json",
  "title": "ModelParseOutput v1 \u2014 what the AI must return for one SMS",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "transaction",
    "bill",
    "phishing"
  ],
  "properties": {
    "kind": {
      "enum": [
        "TRANSACTION",
        "OTP",
        "PROMOTION",
        "BILL_REMINDER",
        "PHISHING_SUSPECT",
        "OTHER"
      ]
    },
    "transaction": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount_paise",
            "direction",
            "merchant",
            "account_last4",
            "txn_date",
            "channel",
            "category"
          ],
          "properties": {
            "amount_paise": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000000
            },
            "direction": {
              "enum": [
                "DEBIT",
                "CREDIT"
              ]
            },
            "merchant": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "account_last4": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "txn_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "channel": {
              "enum": [
                "UPI",
                "CARD",
                "NETBANKING",
                "ATM",
                "WALLET",
                "OTHER"
              ]
            },
            "category": {
              "enum": [
                "FOOD",
                "GROCERIES",
                "TRANSPORT",
                "SHOPPING",
                "BILLS_UTILITIES",
                "ENTERTAINMENT",
                "HEALTH",
                "EDUCATION",
                "RENT",
                "TRANSFER",
                "INCOME",
                "CASH",
                "OTHER"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "bill": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount_due_paise",
            "due_date",
            "biller"
          ],
          "properties": {
            "amount_due_paise": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "due_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "biller": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "phishing": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasons"
          ],
          "properties": {
            "reasons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "SUSPICIOUS_LINK",
                  "URGENCY_THREAT",
                  "ASKS_FOR_CREDENTIALS",
                  "KYC_UPDATE_LURE",
                  "PRIZE_OR_LOTTERY",
                  "IMPERSONATION",
                  "PROMPT_INJECTION",
                  "OTHER"
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "TRANSACTION"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "transaction": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "transaction": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "BILL_REMINDER"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "bill": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "bill": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PHISHING_SUSPECT"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "phishing": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "phishing": {
            "type": "null"
          }
        }
      }
    }
  ]
}
