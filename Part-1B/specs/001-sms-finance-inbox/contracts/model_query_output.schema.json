{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_query_output.schema.json",
  "title": "ModelQueryOutput v1 \u2014 what the AI must return for one question (no numbers/answers)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "query",
    "clarification"
  ],
  "properties": {
    "intent": {
      "enum": [
        "SPEND_QUERY",
        "NEEDS_CLARIFICATION",
        "OUT_OF_SCOPE"
      ]
    },
    "query": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "direction",
            "categories",
            "merchant_contains",
            "date_from",
            "date_to",
            "period_defaulted"
          ],
          "properties": {
            "metric": {
              "enum": [
                "TOTAL",
                "COUNT",
                "AVERAGE",
                "LARGEST",
                "LIST",
                "TOP_MERCHANTS"
              ]
            },
            "direction": {
              "enum": [
                "DEBIT",
                "CREDIT"
              ]
            },
            "categories": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "FOOD",
                  "GROCERIES",
                  "TRANSPORT",
                  "SHOPPING",
                  "BILLS_UTILITIES",
                  "ENTERTAINMENT",
                  "HEALTH",
                  "EDUCATION",
                  "RENT",
                  "TRANSFER",
                  "INCOME",
                  "CASH",
                  "OTHER"
                ]
              }
            },
            "merchant_contains": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "date_to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "period_defaulted": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "clarification": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": {
            "const": "SPEND_QUERY"
          }
        },
        "required": [
          "intent"
        ]
      },
      "then": {
        "properties": {
          "query": {
            "type": "object"
          },
          "clarification": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "query": {
            "type": "null"
          },
          "clarification": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
